# Omni-Shield Backend - Environment Variables
# Copy this file to .env and fill in your values

# =========================================================================
# CRITICAL: Relayer Wallet
# =========================================================================
# Your relayer wallet private key (the account that pays gas for relaying)
# WARNING: Never commit actual private keys to version control!
# Generate a new key for your relayer account
RELAYER_PRIVATE_KEY=0x_YOUR_RELAYER_PRIVATE_KEY_HERE

# =========================================================================
# Deployed Contract Addresses (V6 deployment on Polkadot Hub Testnet)
# =========================================================================
CRYPTO_REGISTRY_ADDRESS=0x237259A349F258eD5d561F90dcb701f4371169B3
STEALTH_PAYMENT_ADDRESS=0x98DB1edC0ED10888d559C641F709A364818B0167
STEALTH_VAULT_ADDRESS=0x5290EC1961854B8a45346f74BeF775E51d4Ba076
ESCROW_ADDRESS=0xFa10b866e5B4a3BDD2d0a978FCB5cAbb334372BE
YIELD_ROUTER_ADDRESS=0xa4B00C51eD83c7a9E1F646E9C0329F4E61f651F1
XCM_ROUTER_ADDRESS=0x2BA3337232F5b1eA4b14f3ca0121C3272c25Bb4E
HUB_ADDRESS=0xCe7917f133B5f31807cC839DCC44f836D8ca7142

# =========================================================================
# Relayer Settings
# =========================================================================
# Polling interval in milliseconds (default: 6000 = 6s)
POLL_INTERVAL_MS=6000

# Max retries for failed transactions
MAX_TX_RETRIES=3

# Gas price multiplier (1.2 = 20% above estimate)
GAS_PRICE_MULTIPLIER=1.2

# Confirmation blocks to wait before confirming dispatch
CONFIRMATION_BLOCKS=2

# Log level: error, warn, info, debug
LOG_LEVEL=info
